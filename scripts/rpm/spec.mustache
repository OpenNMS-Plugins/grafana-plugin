%define name {{{name}}}
%define version {{{version}}}
%define release {{{release}}}
%define buildroot %(mktemp -ud %{_tmppath}/%{name}-%{version}-%{release}-XXXXXX)
%define pluginid {{{pluginId}}}

Name: %{name}
Version: %{version}
{{#dist}}
%define dist {{{dist}}}
Release: %{release}.%{?dist}
{{/dist}}
{{^dist}}
Release: %{release}
{{/dist}}
Summary: {{{description}}}

Group: Installation Script
License: {{{license}}}
Source: %{name}.tar.gz
BuildRoot: %{buildroot}
{{#noarch}}
BuildArch: noarch
%global __strip /bin/true
%define __spec_build_post true
{{/noarch}}
{{#requires}}
Requires: {{{.}}}
{{/requires}}
{{#buildRequires}}
BuildRequires: {{{.}}}
{{/buildRequires}}
AutoReqProv: no

%description
{{{description}}}

%prep
%setup -q -c -n %{name}

%install
mkdir -p %{buildroot}{{{installDir}}}/%{pluginid}
cp -r ./. %{buildroot}{{{installDir}}}/%{pluginid}
{{#hasPostInstallCommands}}

%post
{{#postInstallCommands}}
{{{.}}}
{{/postInstallCommands}}
{{/hasPostInstallCommands}}

%clean
rm -rf %{buildroot}

%files
%defattr(644, grafana, grafana, 755)
{{{installDir}}}/%{pluginid}
{{#hasExecutableFiles}}
%defattr(755, grafana, grafana, 755)
{{#executableFiles}}
{{{.}}}
{{/executableFiles}}
{{/hasExecutableFiles}}
