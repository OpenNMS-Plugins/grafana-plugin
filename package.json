  "version": "12.0.2-SNAPSHOT",
  "description": "An OpenNMS Integration for Grafana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenNMS-Plugins/grafana-plugin.git"
  },
  "author": {
    "name": "OpenNMS",
